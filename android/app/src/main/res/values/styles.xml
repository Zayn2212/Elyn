<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>

        <!-- Status bar: match dark navy app background with light icons. -->
        <item name="android:statusBarColor">#0f172a</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation bar: without this the system nav area defaults to white,
             which shows as a thin white strip at the very bottom of every screen
             on phones with gesture navigation. Match the app background + dark
             icons for the gesture pill. -->
        <item name="android:navigationBarColor">#0f172a</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <!-- Launch / splash theme.
         Android 12+ renders this via the SplashScreen API (windowSplashScreen*).
         Pre-12 falls back to `android:background`. Both paths are populated so
         the splash actually shows on every supported OS version.
         `postSplashScreenTheme` tells Android 12+ what theme to apply once
         the splash finishes — without it the transition flashes back to the
         launcher theme before the app theme kicks in. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Android < 12 -->
        <item name="android:background">@drawable/splash</item>
        <!-- Android 12+ -->
        <item name="windowSplashScreenBackground">#041230</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
